{
  "name": "rallycaststv",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0-rc.117",
      "@effect/platform-node": "4.0.0-rc.117",
      "dotenv": "^17.2.2",
      "effect": "4.0.0-rc.117",
      "zod": "4.6.5",
      "typescript": "^6",
      "@cloudflare/workers-types": "^4.20251213.0",
      "better-auth": "1.6.22",
      "alchemy": "2.0.0-beta.79",
      "wrangler": "^4.77.0",
      "next-themes": "^0.4.6",
      "@tanstack/react-form": "^1.28.0",
      "@tanstack/db": "^0.8.7",
      "@tanstack/query-db-collection": "^1.2.12",
      "@tanstack/react-db": "^0.3.7",
      "@types/react-dom": "^19.2.3",
      "@better-auth/expo": "1.6.22"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:caster": "turbo -F caster dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "e2e": "playwright test",
    "e2e:fixture": "bash scripts/e2e/create-video-fixture.sh",
    "db:generate": "turbo -F @rallycaststv/db db:generate",
    "db:studio": "turbo -F @rallycaststv/db db:studio",
    "deploy": "turbo -F @rallycaststv/infra deploy",
    "deploy:prod": "turbo -F @rallycaststv/infra deploy -- --stage prod",
    "destroy": "turbo -F @rallycaststv/infra destroy",
    "test": "turbo test",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@rallycaststv/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-node": "catalog:",
    "@playwright/test": "1.63.0",
    "@rallycaststv/config": "workspace:*",
    "@types/node": "^26.6.2",
    "lefthook": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.11.2",
    "typescript": "catalog:",
    "ultracite": "7.12.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.15",
    "@xmldom/xmldom": "^0.9.12",
    "body-parser": "^2.3.0",
    "brace-expansion": "^2.1.3",
    "browserslist": "^4.28.8",
    "decode-uri-component": "^0.5.0",
    "esbuild": "^0.25.0",
    "fast-uri": "^3.1.6",
    "hono": "^4.13.5",
    "image-size": "npm:image-size-next@2.1.1",
    "ip-address": "^10.3.1",
    "js-yaml": "^4.3.0",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.1.3",
    "qs": "^6.16.0",
    "sharp": "^0.35.0",
    "shell-quote": "^1.10.0",
    "socket.io-parser": "^4.2.7",
    "undici": "^7.29.0",
    "uuid": "^11.1.1",
    "ws": "^8.20.1"
  },
  "packageManager": "bun@1.3.10",
  "patchedDependencies": {
    "@expo/plist@0.8.1": "patches/@expo%2Fplist@0.8.1.patch"
  }
}
