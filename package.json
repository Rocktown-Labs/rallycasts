{
  "name": "rallycaststv",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@cloudflare/workers-types": "^4.20251213.0",
      "better-auth": "1.6.11",
      "ai": "^6.0.3",
      "alchemy": "^0.91.2",
      "wrangler": "^4.77.0",
      "next-themes": "^0.4.6",
      "@tanstack/react-form": "^1.28.0",
      "@ai-sdk/react": "^3.0.3",
      "@types/react-dom": "^19.2.3",
      "@better-auth/expo": "1.6.11"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:caster": "turbo -F caster dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:generate": "turbo -F @rallycaststv/db db:generate",
    "deploy": "turbo -F @rallycaststv/infra deploy",
    "destroy": "turbo -F @rallycaststv/infra destroy",
    "test": "turbo test",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@rallycaststv/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@rallycaststv/config": "workspace:*",
    "@types/node": "^22.13.14",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.8.1"
  },
  "packageManager": "bun@1.3.10"
}
