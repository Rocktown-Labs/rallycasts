{
  "name": "rallycasts-server",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMIN_EMAILS": "camstewart7@gmail.com",
    "RALLYCASTS_ADMIN_EMAIL": "camstewart7@gmail.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rallycaststv-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "rallycasts-media",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VENUE_PRESENCE",
        "class_name": "VenuePresence",
      },
      {
        "name": "EVENT_COORDINATOR",
        "class_name": "EventCoordinator",
      },
    ],
  },
  "queues": {
    "producers": [
      {
        "binding": "GEOFENCE_EVENTS",
        "queue": "geofence-events",
      },
      {
        "binding": "EVENT_ACTIVITY_QUEUE",
        "queue": "event-activity",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VenuePresence", "EventCoordinator"],
    },
  ],
}
