{
  "name": "rallycasts-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rallycaststv-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "rallycasts-media",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VENUE_PRESENCE",
        "class_name": "VenuePresence",
      },
      {
        "name": "EVENT_COORDINATOR",
        "class_name": "EventCoordinator",
      },
      {
        "name": "CHAT_ROOMS",
        "class_name": "ChatRoom",
      },
      {
        "name": "USER_NOTIFICATIONS",
        "class_name": "UserNotifications",
      },
    ],
  },
  "queues": {
    "producers": [
      {
        "binding": "ADS_EVENTS",
        "queue": "ads-events",
      },
      {
        "binding": "GEOFENCE_EVENTS",
        "queue": "geofence-events",
      },
      {
        "binding": "EVENT_ACTIVITY_QUEUE",
        "queue": "event-activity",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VenuePresence", "EventCoordinator"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChatRoom", "UserNotifications"],
    },
  ],
}
