{
  "expo": {
    "name": "RallyCasts",
    "slug": "rallycaststv",
    "version": "1.0.0",
    "scheme": "rallycaststv",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0d1117",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tv.rallycasts.app"
    },
    "android": {
      "package": "tv.rallycasts.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d1117"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1117",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
